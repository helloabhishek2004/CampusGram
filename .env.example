# ==============================================================================
# Smart Campus — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# DO NOT commit .env or .env.local to version control!
# ==============================================================================

# Supabase (Public - Safe for browser consumption)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase (Server-only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider Configuration ('mock' or 'gemini')
# Use 'mock' when running locally without a Gemini API key.
AI_PROVIDER=mock

# OTP Provider Configuration ('mock' or 'live')
# Use 'mock' for simulated login with deterministic code 123456.
OTP_PROVIDER=mock

# Server and client auth mode ('mock' enables demo institutional IDs and OTP)
AUTH_MODE=mock
NEXT_PUBLIC_AUTH_MODE=mock

# Portfolio Showcase Demo Mode ('true' | 'false')
# When set to 'true', enforces 100% in-memory data isolation from live Supabase,
# external SMS/OTP delivery, remote AI endpoints, and local disk writes.
CAMPUSGRAM_DEMO_MODE=false
NEXT_PUBLIC_CAMPUSGRAM_DEMO_MODE=false

# Server identity mode ('mock' is demo-only; omit/use 'supabase' in production)
# Set AUTH_MODE=supabase and configure Supabase credentials for hosted environments.

# Server-only HMAC secret for the signed mock application session cookie.
# Required when AUTH_MODE=mock with configured Supabase.
AUTH_SESSION_SECRET=

# Google Gemini API Key (Server-only - NEVER expose to browser)
GEMINI_API_KEY=

# App URL Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Module 3: Lost & Found Configuration (Server-only - NEVER expose to browser)
# ==============================================================================
# Direct database URL for worker connections and pgvector queries
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Lost & Found Stateless AI Service (FastAPI)
LOST_FOUND_AI_SERVICE_URL=http://localhost:8000
LOST_FOUND_AI_SERVICE_TOKEN=

# Media Storage Configuration ('local' | 's3' | 'cloudinary')
STORAGE_DRIVER=local

# S3 / Object Storage (Optional for production)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Background Worker Settings
LOST_FOUND_WORKER_POLL_MS=5000
LOST_FOUND_WORKER_CONCURRENCY=2
